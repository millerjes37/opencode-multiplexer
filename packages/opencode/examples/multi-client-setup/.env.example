# OpenCode Server Environment Configuration
# Copy this file to .env and customize as needed

# Server Configuration
OPENCODE_SERVER_PORT=4096
OPENCODE_SERVER_HOSTNAME=127.0.0.1

# Data Directories
# OPENCODE_INSTALL_DIR=/opt/opencode
# OPENCODE_CONFIG_DIR=$HOME/.opencode/config
# OPENCODE_STATE_DIR=$HOME/.opencode/state

# Features
OPENCODE_DISABLE_AUTOUPDATE=false

# Process Management
OPENCODE_PIDFILE=/var/run/opencode.pid

# Logging (if supported by your setup)
# OPENCODE_LOG_LEVEL=info
# OPENCODE_LOG_FILE=/var/log/opencode/server.log

# Node.js Settings
NODE_ENV=production

# Example Usage:
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Edit .env with your settings:
#    nano .env
#
# 3. Source the file before starting server:
#    source .env
#    opencode serve --port $OPENCODE_SERVER_PORT --hostname $OPENCODE_SERVER_HOSTNAME
#
# 4. Or use with docker-compose:
#    docker-compose --env-file .env up
